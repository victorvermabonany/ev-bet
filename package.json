    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.4",
    "vite": "^7.1.9"
  }
